<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GameActivity extends AppCompatActivity, so must use AppCompat theme.
         Fullscreen / notch extension into black borders set here, not Theme.*.Fullscreen (doesn't exist). -->
    <style name="Theme.PrismaGame" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
