#!/bin/sh
# Git executes this file directly, so its shebang must work on every platform.
# On Windows git spawns hooks through MSYS `env`, which refuses a relative path and
# reports "Permission denied" for `#!/usr/bin/env bash`; `#!/bin/sh` is spawned
# directly and works everywhere (Git Bash, Linux, macOS, Termux).
#
# The gate itself stays in `pre-push.sh`: that file is only ever passed to an
# interpreter as an argument, never executed through a shebang, so its bash
# features (arrays, `set -o pipefail`) stay available.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for candidate in bash sh; do
  if command -v "$candidate" >/dev/null 2>&1; then
    exec "$candidate" "$here/pre-push.sh" "$@"
  fi
done

echo "prisma: no bash or sh on PATH; cannot run the pre-push gate." >&2
exit 1
