#version 450

// Qualcomm Snapdragon Game Super Resolution 2 (SGSR 2) — Pass 3: Upscale.
//
// Consumes Pass 1/2 buffers (YCoCgColor, MotionDepthAlphaBuffer) and
// previous-frame full-res history to perform:
// - Jitter-compensated FastLanczos spatial reconstruction
// - 5-tap Catmull-Rom history sampling with YCoCg variance clipping
// - Linear-depth & luma-divergence modulated temporal accumulation
// - RCAS-style local contrast-adaptive sharpening

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_ycocg;
layout(set = 0, binding = 1) uniform sampler2D u_depth;
layout(set = 0, binding = 2) uniform sampler2D u_motion_depth_clip;
layout(set = 0, binding = 3) uniform sampler2D u_history;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D u_output;

layout(std140, set = 0, binding = 5) uniform UpscalerParams {
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    vec4 camera_pos;
    vec2 input_size;
    vec2 output_size;
    vec2 inv_input_size;
    vec2 inv_output_size;
    vec2 jitter_uv;
    float sharpness;
    uint reset;
} params;

vec3 ycocg_to_rgb(vec3 ycc) {
    float t = ycc.r - ycc.b * 0.5;
    float g = ycc.b + t;
    float b = t - ycc.g * 0.5;
    float r = b + ycc.g;
    return vec3(r, g, b);
}

// SGSR 2 polynomial Lanczos-2 approximation over normalized squared distance [0, 1].
float fast_lanczos(float d2) {
    float base = d2 * 0.4444444;
    if (base >= 1.0) {
        return 0.0;
    }
    float y = base - 1.0;
    float y2 = y * y;
    return (0.75 * y + y2) * y2;
}

vec3 sample_history_catmull_rom(vec2 uv) {
    vec2 sample_pos = uv * params.output_size;
    vec2 tex_pos1 = floor(sample_pos - 0.5) + 0.5;
    vec2 f = sample_pos - tex_pos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-5));

    vec2 tc0  = (tex_pos1 - 1.0) * params.inv_output_size;
    vec2 tc3  = (tex_pos1 + 2.0) * params.inv_output_size;
    vec2 tc12 = (tex_pos1 + offset12) * params.inv_output_size;

    vec3 result = vec3(0.0);
    result += textureLod(u_history, vec2(tc12.x, tc0.y),  0.0).rgb * (w12.x * w0.y);
    result += textureLod(u_history, vec2(tc0.x,  tc12.y), 0.0).rgb * (w0.x  * w12.y);
    result += textureLod(u_history, vec2(tc12.x, tc12.y), 0.0).rgb * (w12.x * w12.y);
    result += textureLod(u_history, vec2(tc3.x,  tc12.y), 0.0).rgb * (w3.x  * w12.y);
    result += textureLod(u_history, vec2(tc12.x, tc3.y),  0.0).rgb * (w12.x * w3.y);
    float norm = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(result / max(norm, 1e-5), vec3(0.0));
}

vec3 rgb_to_ycocg(vec3 c) {
    float co = c.r - c.b;
    float t  = c.b + co * 0.5;
    float cg = c.g - t;
    float y  = t + cg * 0.5;
    return vec3(y, co, cg);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= int(params.output_size.x) || gid.y >= int(params.output_size.y)) {
        return;
    }

    vec2 out_uv = (vec2(gid) + 0.5) * params.inv_output_size;
    vec2 in_coord = out_uv * params.input_size - 0.5;
    vec2 base_coord = floor(in_coord + 0.5);
    ivec2 in_size = ivec2(params.input_size);

    vec2 center_offset = (out_uv - params.jitter_uv) * params.input_size - 0.5 - base_coord;

    vec3 curr_sum = vec3(0.0);
    float curr_wsum = 0.0;
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 min_ycc = vec3(1e9);
    vec3 max_ycc = vec3(-1e9);
    vec3 min_rgb = vec3(1e9);
    vec3 max_rgb = vec3(-1e9);

    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 p = clamp(ivec2(base_coord) + ivec2(x, y), ivec2(0), in_size - 1);
            vec3 ycc = texelFetch(u_ycocg, p, 0).rgb;
            vec3 rgb = max(ycocg_to_rgb(ycc), vec3(0.0));

            min_ycc = min(min_ycc, ycc);
            max_ycc = max(max_ycc, ycc);
            min_rgb = min(min_rgb, rgb);
            max_rgb = max(max_rgb, rgb);

            m1 += ycc;
            m2 += ycc * ycc;

            vec2 delta = vec2(x, y) - center_offset;
            float w = fast_lanczos(dot(delta, delta));
            curr_sum += ycc * w;
            curr_wsum += w;
        }
    }

    vec3 current_ycc = (curr_wsum > 1e-4)
        ? clamp(curr_sum / curr_wsum, min_ycc, max_ycc)
        : texelFetch(u_ycocg, clamp(ivec2(base_coord), ivec2(0), in_size - 1), 0).rgb;
    vec3 current_rgb = max(ycocg_to_rgb(current_ycc), vec3(0.0));

    ivec2 center_pos = clamp(ivec2(base_coord), ivec2(0), in_size - 1);
    vec4 mdc = texelFetch(u_motion_depth_clip, center_pos, 0);
    vec2 motion_uv = mdc.xy;
    float depth_clip = mdc.z;
    float lock_factor = mdc.w;

    vec2 prev_uv = out_uv - motion_uv;

    if (params.reset != 0u
        || lock_factor < -0.5
        || any(lessThan(prev_uv, vec2(0.0)))
        || any(greaterThan(prev_uv, vec2(1.0)))) {
        imageStore(u_output, gid, vec4(current_rgb, 1.0));
        return;
    }

    vec3 history_rgb = sample_history_catmull_rom(prev_uv);
    vec3 hist_ycc = rgb_to_ycocg(history_rgb);

    // YCoCg variance clipping modulated by linear-depth clip, luma divergence, and Activate lock.
    vec3 mean = m1 / 9.0;
    vec3 stddev = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    float luma_diff = abs(hist_ycc.x - current_ycc.x) / max(max(hist_ycc.x, current_ycc.x), 0.05);
    float disocclusion = max(depth_clip, clamp(luma_diff * 1.5, 0.0, 1.0));
    float locked_gamma = mix(1.35, 1.75, clamp(lock_factor, 0.0, 1.0));
    float gamma = mix(locked_gamma, 0.80, disocclusion);

    vec3 clipped_ycc = clamp(hist_ycc, mean - gamma * stddev, mean + gamma * stddev);

    float speed = length(motion_uv * params.output_size);
    float vel_weight = clamp(1.0 - speed * 0.015, 0.70, 1.0);
    float base_alpha = mix(0.88, 0.93, clamp(lock_factor, 0.0, 1.0));
    float alpha = base_alpha * vel_weight * mix(1.0, 0.55, disocclusion);

    vec3 resolved_ycc = mix(current_ycc, clipped_ycc, alpha);
    vec3 resolved = max(ycocg_to_rgb(resolved_ycc), vec3(0.0));

    // RCAS-style local contrast-adaptive sharpening.
    if (params.sharpness > 0.001) {
        vec3 mn = min_rgb;
        vec3 mx = max_rgb;
        vec3 hit_min = mn / max(4.0 * mx, vec3(1e-5));
        vec3 hit_max = (1.0 - mx) / max(4.0 * mn - 4.0, vec3(-1e-5));
        vec3 lobe = max(-hit_min, hit_max);
        float max_lobe = clamp(max(lobe.r, max(lobe.g, lobe.b)), -0.1875, 0.0);
        float rcas_w = max_lobe * params.sharpness;
        vec3 sharpened = (resolved + rcas_w * (mn + mx - 2.0 * current_rgb)) / max(1.0 + 2.0 * rcas_w, 1e-5);
        resolved = clamp(sharpened, mn, mx);
    }

    imageStore(u_output, gid, vec4(max(resolved, vec3(0.0)), 1.0));
}
