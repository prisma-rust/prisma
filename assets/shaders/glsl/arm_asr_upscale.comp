#version 450

// Arm Accuracy Super Resolution (Arm ASR) — FSR 2-derived Mobile Temporal Upscaler.
//
// Features:
// - 3x3 dilated closest-depth selection for foreground silhouette motion vectors
// - Jitter-compensated Lanczos2 spatial reconstruction over 3x3 low-res neighborhood
// - Catmull-Rom 5-tap history reprojection with YCoCg variance clipping
// - Reactive luma-divergence modulation + RCAS-style contrast-adaptive sharpening

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_color;
layout(set = 0, binding = 1) uniform sampler2D u_depth;
layout(set = 0, binding = 2) uniform sampler2D u_velocity;
layout(set = 0, binding = 3) uniform sampler2D u_history;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D u_output;

layout(std140, set = 0, binding = 5) uniform UpscalerParams {
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    vec2 input_size;
    vec2 output_size;
    vec2 inv_input_size;
    vec2 inv_output_size;
    vec2 jitter_uv;
    float sharpness;
    uint reset;
} params;

vec3 rgb_to_ycocg(vec3 c) {
    float co = c.r - c.b;
    float t  = c.b + co * 0.5;
    float cg = c.g - t;
    float y  = t + cg * 0.5;
    return vec3(y, co, cg);
}

vec3 ycocg_to_rgb(vec3 ycc) {
    float t = ycc.r - ycc.b * 0.5;
    float g = ycc.b + t;
    float b = t - ycc.g * 0.5;
    float r = b + ycc.g;
    return vec3(r, g, b);
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Fast polynomial Lanczos2 kernel for x in [0, 2].
float lanczos2_weight(float d2) {
    if (d2 >= 4.0) {
        return 0.0;
    }
    // FSR2-style fast approximation: (25/16 * (2/5 * d2 - 1)^2 - 9/16) * (1/4 * d2 - 1)^2
    float a = 0.4 * d2 - 1.0;
    float b = 0.25 * d2 - 1.0;
    float w = (1.5625 * a * a - 0.5625) * (b * b);
    return max(w, 0.0);
}

vec3 sample_history_catmull_rom(vec2 uv) {
    vec2 sample_pos = uv * params.output_size;
    vec2 tex_pos1 = floor(sample_pos - 0.5) + 0.5;
    vec2 f = sample_pos - tex_pos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-5));

    vec2 tc0  = (tex_pos1 - 1.0) * params.inv_output_size;
    vec2 tc3  = (tex_pos1 + 2.0) * params.inv_output_size;
    vec2 tc12 = (tex_pos1 + offset12) * params.inv_output_size;

    vec3 result = vec3(0.0);
    result += textureLod(u_history, vec2(tc12.x, tc0.y),  0.0).rgb * (w12.x * w0.y);
    result += textureLod(u_history, vec2(tc0.x,  tc12.y), 0.0).rgb * (w0.x  * w12.y);
    result += textureLod(u_history, vec2(tc12.x, tc12.y), 0.0).rgb * (w12.x * w12.y);
    result += textureLod(u_history, vec2(tc3.x,  tc12.y), 0.0).rgb * (w3.x  * w12.y);
    result += textureLod(u_history, vec2(tc12.x, tc3.y),  0.0).rgb * (w12.x * w3.y);
    float norm = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(result / max(norm, 1e-5), vec3(0.0));
}

vec2 reproject_camera(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = params.inv_view_proj * clip;
    if (abs(world.w) < 1e-6) {
        return vec2(-1.0);
    }
    world /= world.w;
    vec4 prev = params.prev_view_proj * world;
    if (prev.w <= 1e-5) {
        return vec2(-1.0);
    }
    return prev.xy / prev.w * 0.5 + 0.5;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= int(params.output_size.x) || gid.y >= int(params.output_size.y)) {
        return;
    }

    vec2 out_uv = (vec2(gid) + 0.5) * params.inv_output_size;
    vec2 in_coord = out_uv * params.input_size - 0.5;
    vec2 base_coord = floor(in_coord + 0.5);
    vec2 base_uv = (base_coord + 0.5) * params.inv_input_size;

    vec2 center_offset = (out_uv - params.jitter_uv) * params.input_size - 0.5 - base_coord;

    vec3 curr_sum = vec3(0.0);
    float curr_wsum = 0.0;
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 min_rgb = vec3(1e9);
    vec3 max_rgb = vec3(-1e9);

    // 3x3 dilated closest-depth search (standard [0, 1] depth: near = 0, far = 1).
    float closest_depth = 1.0;
    vec2 closest_uv = base_uv;

    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 sample_uv = clamp(base_uv + vec2(x, y) * params.inv_input_size, vec2(0.0), vec2(1.0));
            vec3 c = max(textureLod(u_color, sample_uv, 0.0).rgb, vec3(0.0));
            float d = textureLod(u_depth, sample_uv, 0.0).r;
            if (d < closest_depth) {
                closest_depth = d;
                closest_uv = sample_uv;
            }

            min_rgb = min(min_rgb, c);
            max_rgb = max(max_rgb, c);

            vec3 ycc = rgb_to_ycocg(c);
            m1 += ycc;
            m2 += ycc * ycc;

            vec2 delta = vec2(x, y) - center_offset;
            float w = lanczos2_weight(dot(delta, delta));
            curr_sum += c * w;
            curr_wsum += w;
        }
    }

    vec3 current = curr_sum / max(curr_wsum, 1e-5);
    current = clamp(current, min_rgb, max_rgb);

    if (params.reset != 0u) {
        imageStore(u_output, gid, vec4(current, 1.0));
        return;
    }

    // Dilated foreground motion vector.
    vec2 obj_vel = textureLod(u_velocity, closest_uv, 0.0).rg;
    vec2 prev_uv = (dot(obj_vel, obj_vel) > 1e-12)
        ? (out_uv - obj_vel)
        : reproject_camera(out_uv, closest_depth);

    if (any(lessThan(prev_uv, vec2(0.0))) || any(greaterThan(prev_uv, vec2(1.0)))) {
        imageStore(u_output, gid, vec4(current, 1.0));
        return;
    }

    vec3 history = sample_history_catmull_rom(prev_uv);

    // YCoCg variance clipping (slightly wider gamma on static pixels for Arm ASR stability).
    vec3 mean = m1 / 9.0;
    vec3 stddev = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    float luma_diff = abs(luma(history) - luma(current)) / max(max(luma(history), luma(current)), 0.05);
    float reactive = clamp(luma_diff * 1.5, 0.0, 1.0);
    float gamma = mix(1.35, 0.85, reactive);

    vec3 hist_ycc = rgb_to_ycocg(history);
    vec3 clipped_ycc = clamp(hist_ycc, mean - gamma * stddev, mean + gamma * stddev);
    vec3 clipped_history = max(ycocg_to_rgb(clipped_ycc), vec3(0.0));

    // Temporal accumulation factor modulated by motion speed & reactive divergence.
    float speed = length((out_uv - prev_uv) * params.output_size);
    float vel_factor = clamp(1.0 - speed * 0.015, 0.70, 1.0);
    float alpha = 0.90 * vel_factor * mix(1.0, 0.60, reactive);

    vec3 resolved = mix(current, clipped_history, alpha);

    // RCAS-inspired local contrast-adaptive sharpening.
    if (params.sharpness > 0.001) {
        vec3 mn = min_rgb;
        vec3 mx = max_rgb;
        vec3 hit_min = mn / max(4.0 * mx, vec3(1e-5));
        vec3 hit_max = (1.0 - mx) / max(4.0 * mn - 4.0, vec3(-1e-5));
        vec3 lobe = max(-hit_min, hit_max);
        float max_lobe = clamp(max(lobe.r, max(lobe.g, lobe.b)), -0.1875, 0.0);
        float rcas_w = max_lobe * params.sharpness;
        vec3 sharpened = (resolved + rcas_w * (mn + mx - 2.0 * current)) / max(1.0 + 2.0 * rcas_w, 1e-5);
        resolved = clamp(sharpened, mn, mx);
    }

    imageStore(u_output, gid, vec4(max(resolved, vec3(0.0)), 1.0));
}
